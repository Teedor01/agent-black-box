# Copy to .env and fill in real values locally.
# In deployment, these come from AWS Secrets Manager (see infra/SETUP.md) —
# this file exists for local dev only and must never contain real secrets.

# CockroachDB — application backend, read/write, scoped to the 6 project tables
COCKROACHDB_CONNECTION_STRING=postgresql://<user>:<password>@<host>:26257/<database>?sslmode=verify-full

# CockroachDB Managed MCP Server — runtime read-only credential.
# This MUST be a Service Account API key (infra/SETUP.md Step 5b), NOT
# the OAuth token from connecting your own Claude Code (Step 5a) -- an
# OAuth token requires an interactive browser and will not work here.
COCKROACHDB_MCP_ENDPOINT=https://cockroachlabs.cloud/mcp
COCKROACHDB_MCP_BEARER_TOKEN=
# Required by every MCP tool call (confirmed from the real tool schema)
COCKROACHDB_MCP_DATABASE=defaultdb
# Required unless your MCP credential already has one associated with it
# server-side. Passed as a tool argument on every call, NOT an HTTP
# header -- confirmed by the server's own error message when this was
# missing. Find the ID in your cluster's Overview page URL.
COCKROACHDB_MCP_CLUSTER_ID=

# AWS
AWS_ACCESS_KEY_ID=<your access key>
AWS_SECRET_ACCESS_KEY=<your secret key>
AWS_REGION=us-east-1

# Bedrock model IDs — set these to the exact IDs confirmed in infra/SETUP.md
# Step 3. The embedding model's output dimension MUST match the VECTOR(...)
# size in src/db/schema.sql.
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
BEDROCK_TEXT_MODEL_ID=anthropic.claude-sonnet-5

# Project scope for this demo build
DEMO_PROJECTS=crynux,neptune_privacy
